# Backend API base URL (e.g., http://localhost:4000)
API_BASE_URL=http://localhost:4000

# Prisma database connection string
DB_URL=postgresql://user:password@localhost:5432/opportunity_radar

# Scraper polling interval in minutes (default 5)
SCRAPER_INTERVAL_MINUTES=5

# Enable browser notifications (true/false)
NOTIFY_ENABLED=true